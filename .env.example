# Copy this file to .env and fill in the values. Never commit .env.
APP_ENV=development
APP_PORT=8080
SESSION_SECRET=change-me-to-a-long-random-string

# --- Supabase (dashboard -> Project Settings) ---

# Database -> Connection string -> "Session pooler" (port 5432).
# Used by the Python server for all SQL queries.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# API -> Project URL and the "anon" / publishable key.
# Used only for sign-in, sign-out and password changes.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=paste-the-anon-key-here
